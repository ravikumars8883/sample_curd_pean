# Copy to server/.env and adjust for your environment
PORT=3000

# PostgreSQL connection
PGHOST=localhost
PGPORT=5432
PGDATABASE=sample_curd_pean
PGUSER=postgres
PGPASSWORD=postgres

# Set to true when connecting to a managed instance that requires TLS
PGSSL=false

# Origin allowed by CORS (Angular dev server)
CLIENT_ORIGIN=http://localhost:4200
